{
  "$comment": "PsConnector design tokens: the one place colours, sizes, type and icons are defined. The viewer (crates/psconnector-view, via build.rs) and web pages (design/tokens.css) are generated from this file. See design/README.md.",
  "color": {
    "$roles": {
      "bg": "window background (start screen)",
      "surface": "bars, side panels, cards, fields",
      "raised": "controls, menus, popovers",
      "hover": "hovered or selected control; neutral badge",
      "border": "1px lines: separators, control and card borders",
      "text": "body text",
      "muted": "secondary text, captions, section labels",
      "faint": "least important text (last log line)",
      "accent": "primary button, selection, running state",
      "accent_soft": "accent background (toggled button, running strip)",
      "accent_text": "accent text on a neutral background, links",
      "danger": "destructive button, recording, stop",
      "danger_soft": "danger background (banner, recording strip)",
      "danger_text": "danger text",
      "success": "status dot: on, running",
      "success_soft": "success background (badge)",
      "success_text": "success text",
      "warning": "warnings"
    },
    "dark": {
      "bg": "#0E0F12",
      "surface": "#16181D",
      "raised": "#1F2229",
      "hover": "#2A2E37",
      "border": "#2A2E37",
      "text": "#E8EAED",
      "muted": "#9AA0AB",
      "faint": "#6B717C",
      "accent": "#2F6FE4",
      "accent_soft": "#17233A",
      "accent_text": "#A9C4F8",
      "danger": "#D93A40",
      "danger_soft": "#2A1517",
      "danger_text": "#F0868A",
      "success": "#3DD68C",
      "success_soft": "#133B29",
      "success_text": "#7EE2B1",
      "warning": "#E2A93B"
    },
    "light": {
      "bg": "#FFFFFF",
      "surface": "#F6F7F9",
      "raised": "#FFFFFF",
      "hover": "#ECEEF1",
      "border": "#E3E5E8",
      "text": "#14161A",
      "muted": "#5F6672",
      "faint": "#8A909B",
      "accent": "#2F6FE4",
      "accent_soft": "#E6EEFC",
      "accent_text": "#1F55C0",
      "danger": "#D93A40",
      "danger_soft": "#FDECEC",
      "danger_text": "#B42328",
      "success": "#1F9D63",
      "success_soft": "#E3F6EC",
      "success_text": "#167A4C",
      "warning": "#B7791F"
    }
  },
  "size": {
    "$comment": "points (egui) = CSS px",
    "control": 28,
    "form": 32,
    "radius": 6,
    "panel_radius": 10,
    "caption": 12,
    "body": 13,
    "title": 15,
    "heading": 20,
    "label": 11,
    "panel_pad": 16,
    "scroll_bar": 6,
    "scroll_gap": 4,
    "gap": 8,
    "icon": 16
  },
  "font": {
    "text": ["Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", "system-ui", "sans-serif"],
    "icon": "Phosphor (regular), crates/psconnector-view/assets/Phosphor.ttf"
  },
